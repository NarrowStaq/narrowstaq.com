---
import Logo from './Logo.astro';
import { site } from '../config';

const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <div>
      <Logo />
      <p class="tag">Fractional CTO &amp; technical leadership.</p>
    </div>
    <ul class="mono">
      <li><a href={`mailto:${site.email}`}>email</a></li>
      <li><a href={site.linkedin} target="_blank" rel="noopener">linkedin</a></li>    </ul>
  </div>
  <div class="container legal mono">
    <span>© {year} Narrowstaq</span>
    <span>built static · no cookies · no trackers</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 40px;
    background: var(--bg);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 32px;
  }

  .tag {
    color: var(--text-muted);
    font-size: 15px;
    margin-top: 12px;
  }

  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }

  ul a {
    color: var(--text-muted);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--accent);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-dim);
  }
</style>
