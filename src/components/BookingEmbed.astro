---
// Opens the Cal.com scheduler in a pop-up for any link marked `data-booking`.
// The embed script loads only when someone hovers, focuses or clicks a booking link,
// so ordinary page views make no third-party requests.
import { site } from '../config';
---

<script is:inline define:vars={{ calLink: site.calLink }}>
  const NS = 'intro';
  let ready = false;

  function load() {
    if (ready) return;
    ready = true;
    // Official Cal.com embed loader (queues calls until embed.js arrives)
    (function (C, A, L) {
      const p = (a, ar) => a.q.push(ar);
      const d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    Cal('init', NS, { origin: 'https://cal.com' });
    Cal.ns[NS]('ui', {
      theme: 'dark',
      cssVarsPerTheme: { dark: { 'cal-brand': '#ff8a3d' } },
      hideEventTypeDetails: false,
      layout: 'month_view',
    });
  }

  for (const el of document.querySelectorAll('[data-booking]')) {
    el.addEventListener('pointerenter', load, { once: true });
    el.addEventListener('focus', load, { once: true });
    el.addEventListener('click', (e) => {
      // Let cmd/ctrl/middle-click open the plain Cal.com page in a new tab
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      load();
      Cal.ns[NS]('modal', { calLink, config: { layout: 'month_view', theme: 'dark' } });
    });
  }
</script>
