---
// "Sound familiar?": the situations that make someone look for a fractional CTO.
const signals = [
  {
    title: "You're a non-technical founder",
    body: "You're making big technology bets, like hiring, vendors and architecture, and you don't have anyone to pressure-test them.",
  },
  {
    title: 'The team ships, but slowly',
    body: 'Deadlines slip, estimates mean little, and nobody can say clearly why. Your engineers need direction, not more pressure.',
  },
  {
    title: 'An outside agency built your product',
    body: "You're paying for work you can't evaluate and wondering whether to bring development in-house, and how.",
  },
  {
    title: 'A raise or acquisition is coming',
    body: 'Investors will ask hard technical questions. You want clear answers and a stack that holds up to diligence.',
  },
  {
    title: 'Your CTO just left',
    body: 'You need steady leadership now, plus help defining and hiring the right permanent replacement.',
  },
  {
    title: 'The system is straining',
    body: 'Outages, rising cloud bills, and a codebase everyone is afraid to touch. Growth is exposing the shortcuts.',
  },
];
---

<section class="section" id="signals">
  <div class="container">
    <p class="eyebrow" data-reveal>sound familiar?</p>
    <h2 class="section-title" data-reveal>Most companies don't need a full-time CTO yet. They do need CTO-level judgment.</h2>

    <div class="grid">
      {
        signals.map((s, i) => (
          <article class="card" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
            <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 64px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card {
    background: var(--bg);
    padding: 32px 28px 36px;
    transition: background 0.25s ease;
  }

  .card:hover {
    background: var(--bg-raised);
  }

  .num {
    font-size: 12px;
    color: var(--accent);
  }

  h3 {
    font-size: 21px;
    margin-top: 18px;
  }

  p {
    color: var(--text-muted);
    font-size: 15.5px;
    margin-top: 12px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
