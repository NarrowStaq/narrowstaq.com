---
import { site } from '../config';

const services = [
  {
    tag: 'fractional_cto',
    title: 'Fractional CTO',
    featured: true,
    summary: 'Ongoing technical leadership on a monthly retainer. I sit at the leadership table, own the technical direction, and stay accountable for the outcome.',
    points: [
      'Technical strategy and a roadmap tied to business goals',
      'Engineering team leadership, hiring, and process',
      'Architecture and build-vs-buy decisions',
      'Vendor and agency oversight',
      'Board and investor communication',
    ],
  },
  {
    tag: 'due_diligence',
    title: 'Technical Due Diligence',
    summary: 'A focused assessment before you invest, acquire, raise or rebuild, with a clear, plain-English report on what you have and what it will take.',
    points: [
      'Codebase, architecture, and security review',
      'Team and delivery process assessment',
      'Risk register with prioritized remediation',
    ],
  },
  {
    tag: 'tech_assessment',
    title: 'Architecture & Team Audit',
    summary: 'A one-time deep dive for companies that feel stuck. I find what is slowing you down and give you a concrete plan to fix it.',
    points: [
      'Delivery bottleneck analysis',
      'Infrastructure and cloud cost review',
      '90-day action plan',
    ],
  },
  {
    tag: 'build',
    title: 'Hands-on Development',
    summary: 'When the job calls for it, I still build. MVPs, integrations, automation, and performance work, delivered by someone who thinks about the whole system.',
    points: ['MVPs and prototypes', 'Workflow automation and integrations', 'Performance and reliability fixes'],
  },
];
---

<section class="section" id="services">
  <div class="container">
    <p class="eyebrow" data-reveal>services</p>
    <h2 class="section-title" data-reveal>Leadership first. Hands on keyboard when it counts.</h2>
    <p class="section-lede" data-reveal>
      Every engagement is shaped around where your company is today. Most clients start with a conversation and an
      audit, then move into an ongoing fractional role.
    </p>

    <div class="services">
      {
        services.map((s) => (
          <article class:list={['service', { featured: s.featured }]} data-reveal>
            <div class="service-head">
              <span class="tag mono">{s.tag}</span>
              {s.featured && <span class="badge mono">core offering</span>}
            </div>
            <h3>{s.title}</h3>
            <p class="summary">{s.summary}</p>
            <ul>
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            {s.featured && (
              <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-booking>
                talk about a retainer <span class="arrow">→</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 64px;
  }

  .service {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .service:hover {
    border-color: var(--line-strong);
  }

  .featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 56px;
    padding: 44px 40px;
    border-color: rgba(255, 138, 61, 0.35);
    background:
      radial-gradient(ellipse at top right, var(--accent-soft), transparent 60%),
      var(--bg-card);
  }

  .featured .service-head,
  .featured h3,
  .featured .summary {
    grid-column: 1;
  }

  .featured ul {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: center;
    margin-top: 0;
  }

  .featured .btn {
    grid-column: 1;
    justify-self: start;
    margin-top: 28px;
  }

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tag {
    font-size: 12px;
    color: var(--text-dim);
  }

  .tag::before {
    content: '#';
    color: var(--accent);
  }

  .badge {
    font-size: 11px;
    color: var(--accent);
    border: 1px solid rgba(255, 138, 61, 0.4);
    border-radius: 999px;
    padding: 2px 10px;
  }

  h3 {
    font-size: 26px;
    margin-top: 16px;
  }

  .featured h3 {
    font-size: clamp(30px, 3.4vw, 40px);
  }

  .summary {
    color: var(--text-muted);
    margin-top: 14px;
    font-size: 16px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 10px;
  }

  li {
    position: relative;
    padding-left: 24px;
    font-size: 15px;
  }

  li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .featured li {
    font-size: 16.5px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }

  .featured li:last-child {
    border-bottom: 0;
  }

  @media (max-width: 960px) {
    .services {
      grid-template-columns: 1fr;
    }
    .featured {
      display: flex;
      padding: 32px 28px;
    }
    .featured ul {
      margin-top: 24px;
    }
  }
</style>
